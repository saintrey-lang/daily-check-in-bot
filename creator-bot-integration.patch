+import { getMessage } from "@/lib/discord/api";
+import { StarplayerSheetsStore } from "@/lib/starplayer/sheets";
+
+export async function GET(_request: Request, context: { params: Promise<{ id: string }> }) {
+  const { id } = await context.params;
+  if (!/^\d{17,20}$/.test(id)) return new Response("Not found", { status: 404 });
+  try {
+    const submission = (await new StarplayerSheetsStore().readSubmissions()).find((item) => item.id === id);
+    if (!submission?.attachmentName || !submission.messageUrl.endsWith(`/api/starplayer/attachments/${id}`) ||
+      !/^\d{17,20}$/.test(submission.channelId) || !/^\d{17,20}$/.test(submission.messageId)) {
+      return new Response("Not found", { status: 404 });
+    }
+    const message = await getMessage(submission.channelId, submission.messageId);
+    if (message.id !== submission.messageId || message.channel_id !== submission.channelId) {
+      throw new Error("Discord returned an unexpected submission message.");
+    }
+    const attachment = message.attachments.find((item) => item.url && item.id);
+    if (!attachment) return new Response("Attachment unavailable", { status: 404 });
+    const url = new URL(attachment.url);
+    if (url.protocol !== "https:" || url.hostname !== "cdn.discordapp.com") {
+      throw new Error("Discord returned an unexpected attachment URL.");
+    }
+    return new Response(null, { status: 302, headers: {
+      Location: url.toString(), "Cache-Control": "private, no-store",
+    } });
+  } catch (error) {
+    console.error("Could not open Starplayer attachment.", error);
+    return new Response("Attachment unavailable", { status: 503 });
+  }
+}
