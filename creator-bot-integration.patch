+import { generateKeyPairSync } from "node:crypto";
+import { afterEach, describe, expect, it } from "vitest";
+import { googlePrivateKey } from "@/lib/config";
+
+const pem = generateKeyPairSync("rsa", { modulusLength: 2048 }).privateKey.export({ type: "pkcs8", format: "pem" }).toString().trim();
+const previous = process.env.GOOGLE_PRIVATE_KEY;
+
+afterEach(() => { process.env.GOOGLE_PRIVATE_KEY = previous; });
+
+describe("service account key formats", () => {
+  it.each([pem, pem.replace(/\n/g, "\\n"), JSON.stringify(pem), JSON.stringify({ private_key: pem })])(
+    "accepts a complete private key", (input) => {
+      process.env.GOOGLE_PRIVATE_KEY = input;
+      expect(googlePrivateKey()).toBe(pem);
+    },
+  );
+
+  it("rejects an incomplete key with a useful error", () => {
+    process.env.GOOGLE_PRIVATE_KEY = "-----BEGIN PRIVATE KEY-----\\ncut off";
+    expect(() => googlePrivateKey()).toThrow("Copy the complete private_key");
+  });
+});
