+import { discordConfig } from "@/lib/config";
+import { deleteMessage, deleteOriginalInteraction, editMessage, editOriginalInteraction, openDirectMessage } from "@/lib/discord/api";
+import { deferredResponse, interactionError, modalResponse, parseModalValues } from "@/lib/discord/interactions";
+import { STARPLAYER_CHANNEL_ID, categoryFor, todayInManila, validateSubmission, validateTaskDate, validateTaskTitle, type StarplayerSubmission } from "@/lib/starplayer/core";
+import { StarplayerSheetsStore } from "@/lib/starplayer/sheets";
+import type { DiscordInteraction } from "@/lib/types";
+import { discordUser } from "@/lib/utils";
+
+export const STARPLAYER_MENU_ID = "starplayer:category:v1";
+export const STARPLAYER_MODAL_PREFIX = "starplayer:submit:v1:";
+const LINK_ID = "starplayer:link";
+const FILE_ID = "starplayer:file";
+const DATE_ID = "starplayer:task-date";
+const TITLE_ID = "starplayer:task-title";
+
+type UploadedFile = { id: string; filename: string; url: string; size: number; content_type?: string };
+
+export function starplayerModal(categoryId: string): Record<string, unknown> {
+  const category = categoryFor(categoryId);
+  if (!category) throw new Error("Invalid Starplayer task category.");
+  return {
+    custom_id: `${STARPLAYER_MODAL_PREFIX}${category.id}`,
+    title: `${category.label} submission`,
+    components: [
+      { type: 18, label: "Task Title", component: {
+        type: 4, custom_id: TITLE_ID, style: 1, placeholder: "What task did you complete?",
+        max_length: 150, required: true,
+      } },
+      { type: 18, label: "Task Date (YYYY-MM-DD)", component: {
+        type: 4, custom_id: DATE_ID, style: 1, value: todayInManila(), placeholder: "YYYY-MM-DD",
+        min_length: 10, max_length: 10, required: true,
+      } },
+      { type: 18, label: "Submission Link (optional)", component: {
+        type: 4, custom_id: LINK_ID, style: 1, placeholder: "https://...", max_length: 1000, required: false,
+      } },
+      { type: 18, label: "Submission Attachment (optional)", component: {
+        type: 19, custom_id: FILE_ID, min_values: 0, max_values: 1, required: false,
+      } },
+    ],
+  };
+}
+
+function validChannel(interaction: DiscordInteraction): boolean {
+  const guildId = process.env.STARPLAYER_GUILD_ID?.trim() || "1293483684888055840";
+  return interaction.guild_id === guildId && interaction.channel_id === STARPLAYER_CHANNEL_ID;
+}
+
+export function handleStarplayerMenu(interaction: DiscordInteraction): Response {
+  if (!validChannel(interaction)) return interactionError("Use the Starplayer submission menu in its designated channel.");
+  const category = categoryFor(interaction.data?.values?.[0] ?? "");
+  if (!category) return interactionError("Choose a valid task category.");
+  return modalResponse(starplayerModal(category.id));
+}
+
+function selectedFile(interaction: DiscordInteraction): UploadedFile | null {
+  const id = parseModalValues(interaction.data?.components ?? [])[FILE_ID];
+  if (!id) return null;
+  const attachment = interaction.data?.resolved?.attachments?.[id];
+  if (!attachment || attachment.id !== id || !attachment.filename || !attachment.url) {
+    throw new Error("The uploaded file could not be read. Please submit it again.");
+  }
+  return attachment;
+}
+
+async function postSubmission(submission: StarplayerSubmission, file: UploadedFile | null): Promise<{ channelId: string; messageId: string; attachmentIds: string[] }> {
+  const category = categoryFor(submission.category)!;
+  const payload = {
+    embeds: [{ color: 0xDFF760, title: `Saving your ${category.label} task…`,
+      description: "Your task is being recorded. You will receive a confirmation here when it is saved.",
+      fields: [
+        { name: "Task Title", value: submission.taskTitle },
+        { name: "Task Date", value: submission.taskDate },
+        ...(submission.link ? [{ name: "Submission link", value: submission.link }] : []),
+        ...(file ? [{ name: "Attachment", value: file.filename.slice(0, 250) }] : []),
+      ], footer: { text: `Submission ID: ${submission.id}` },
+    }], allowed_mentions: { parse: [] },
+  };
+  const form = new FormData();
+  form.append("payload_json", JSON.stringify(payload));
+  if (file) {
+    const url = new URL(file.url);
+    if (url.protocol !== "https:" || url.hostname !== "cdn.discordapp.com" || file.size > 25_000_000) {
+      throw new Error("The attachment could not be copied. Please upload a file under 25 MB.");
+    }
+    const source = await fetch(url, { cache: "no-store" });
+    if (!source.ok) throw new Error("The attachment expired before it could be saved. Please try again.");
+    const bytes = await source.arrayBuffer();
+    if (bytes.byteLength > 25_000_000) throw new Error("Please upload a file under 25 MB.");
+    form.append("files[0]", new Blob([bytes], { type: file.content_type || "application/octet-stream" }), file.filename);
+  }
+  let channelId: string;
+  try {
+    channelId = await openDirectMessage(submission.userId);
+  } catch (error) {
+    if (error instanceof Error && /403|50007/.test(error.message)) {
+      throw new Error("I couldn't send you a direct message. Allow DMs from server members, then submit again.");
+    }
+    throw error;
+  }
+  const response = await fetch(`https://discord.com/api/v10/channels/${channelId}/messages`, {
+    method: "POST", headers: { authorization: `Bot ${discordConfig().botToken}` }, body: form,
+  });
+  if (response.status === 403) throw new Error("I couldn't send you a direct message. Allow DMs from server members, then submit again.");
+  if (!response.ok) throw new Error(`Discord could not save the submission in your DMs (${response.status}).`);
+  const message = await response.json() as { id: string; attachments?: Array<{ id: string }> };
+  if (file && !message.attachments?.length) {
+    await deleteMessage(channelId, message.id).catch(() => {});
+    throw new Error("The attachment could not be saved. Please submit it again.");
+  }
+  return { channelId, messageId: message.id, attachmentIds: message.attachments?.map((item) => item.id) ?? [] };
+}
+
+export function handleStarplayerSubmission(interaction: DiscordInteraction, background: (task: () => Promise<void>) => void): Response {
+  if (!validChannel(interaction)) return interactionError("Use the Starplayer submission menu in its designated channel.");
+  const category = categoryFor(interaction.data?.custom_id?.slice(STARPLAYER_MODAL_PREFIX.length) ?? "");
+  if (!category) return interactionError("Choose a valid task category.");
+  let file: UploadedFile | null;
+  let link: string;
+  let taskDate: string;
+  let taskTitle: string;
+  try {
+    file = selectedFile(interaction);
+    const values = parseModalValues(interaction.data?.components ?? []);
+    taskDate = validateTaskDate(values[DATE_ID] || todayInManila());
+    taskTitle = validateTaskTitle(values[TITLE_ID] ?? "");
+    link = validateSubmission(values[LINK_ID] ?? "", file?.filename ?? "");
+  } catch (error) {
+    return interactionError(error instanceof Error ? error.message : "Invalid submission.");
+  }
+  const user = discordUser(interaction);
+  background(async () => {
+    const store = new StarplayerSheetsStore();
+    await store.setup();
+    const existing = (await store.readSubmissions()).find((item) => item.id === interaction.id);
+    if (existing) {
+      await editOriginalInteraction(interaction.application_id, interaction.token, { content: `Already recorded: ${existing.messageUrl}` });
+      return;
+    }
+    const record: StarplayerSubmission = {
+      id: interaction.id, submittedAt: new Date().toISOString(), taskDate, taskTitle, userId: user.id,
+      username: user.username, displayName: user.displayName,
+      category: category.id, link, attachmentName: file?.filename ?? "", messageUrl: "", messageId: "",
+      channelId: STARPLAYER_CHANNEL_ID, guildId: interaction.guild_id!,
+    };
+    const { channelId, messageId, attachmentIds } = await postSubmission(record, file);
+    record.messageId = messageId;
+    record.channelId = channelId;
+    record.messageUrl = file
+      ? `https://creator-discord-bot.vercel.app/api/starplayer/attachments/${record.id}`
+      : `https://discord.com/channels/@me/${channelId}/${messageId}`;
+    try {
+      if (!await store.appendSubmission(record)) {
+        throw new Error("This submission was already recorded.");
+      }
+    } catch (error) {
+      await deleteMessage(channelId, messageId).catch(() => {});
+      throw error;
+    }
+    try {
+      await editMessage(channelId, messageId, {
+        attachments: attachmentIds.map((id) => ({ id })),
+        embeds: [{ color: 0xDFF760, title: "Starplayer task submitted ✓",
+          description: "Your task has been recorded in the Starplayer Sheet.",
+          fields: [
+            { name: "Category", value: category.label },
+            { name: "Task Title", value: taskTitle },
+            { name: "Task Date", value: taskDate },
+            ...(link ? [{ name: "Submission link", value: link }] : []),
+            ...(file ? [{ name: "Attachment", value: file.filename.slice(0, 250) }] : []),
+          ], footer: { text: `Submission ID: ${record.id}` },
+        }],
+      });
+    } catch (error) {
+      console.error("Starplayer task saved, but the DM confirmation could not be finished.", error);
+      await editOriginalInteraction(interaction.application_id, interaction.token, {
+        content: `Your task was recorded in the Sheet. If your DM still says it is saving, use submission ID ${record.id} to find it.`,
+      });
+      return;
+    }
+    await deleteOriginalInteraction(interaction.application_id, interaction.token).catch(async (error) => {
+      console.warn("Could not dismiss the Starplayer loading response.", error);
+      await editOriginalInteraction(interaction.application_id, interaction.token, {
+        content: "Your confirmation is in your DMs.",
+      }).catch((editError) => console.warn("Could not update the Starplayer loading response.", editError));
+    });
+  });
+  return deferredResponse(true);
+}
