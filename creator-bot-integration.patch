+import { generateKeyPairSync, sign } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { STARPLAYER_CHANNEL_ID, todayInManila } from "@/lib/starplayer/core";
+import { STARPLAYER_MENU_ID, handleStarplayerSubmission } from "@/lib/starplayer/interactions";
+import type { DiscordInteraction } from "@/lib/types";
+
+const base: DiscordInteraction = {
+  id: "123", application_id: "321", token: "token", type: 3,
+  guild_id: "1293483684888055840", channel_id: STARPLAYER_CHANNEL_ID,
+  member: { user: { id: "99", username: "player" } },
+};
+
+describe("Starplayer HTTP interactions", () => {
+  it("routes a signed dropdown through the existing Creator endpoint without changing its other handlers", async () => {
+    const pair = generateKeyPairSync("ed25519");
+    const spki = pair.publicKey.export({ type: "spki", format: "der" });
+    process.env.DISCORD_PUBLIC_KEY = spki.subarray(spki.length - 32).toString("hex");
+    const body = JSON.stringify({ ...base, data: { custom_id: STARPLAYER_MENU_ID, values: ["engagement"] } });
+    const timestamp = "1788480000";
+    const response = await (await import("@/app/api/discord/interactions/route")).POST(new Request("https://example.com/api/discord/interactions", {
+      method: "POST", body,
+      headers: { "x-signature-ed25519": sign(null, Buffer.from(timestamp + body), pair.privateKey).toString("hex"),
+        "x-signature-timestamp": timestamp },
+    }));
+    expect(response.status).toBe(200);
+    const result = await response.json();
+    expect(result.type).toBe(9);
+    expect(result.data.custom_id).toBe("starplayer:submit:v1:engagement");
+    expect(result.data.components).toMatchObject([
+      { label: "Task Title", component: { type: 4, required: true, max_length: 150 } },
+      { label: "Task Date (YYYY-MM-DD)", component: { type: 4, required: true, value: todayInManila() } },
+      { component: { type: 4, required: false } },
+      { component: { type: 19, min_values: 0, required: false } },
+    ]);
+  });
+
+  it("opens a submission form for Others", async () => {
+    const response = (await import("@/lib/starplayer/interactions")).starplayerModal("others");
+    expect(response.title).toBe("Others submission");
+  });
+
+  it("rejects a future task date before accepting a submission", async () => {
+    let invoked = false;
+    const response = handleStarplayerSubmission({ ...base, type: 5,
+      data: { custom_id: "starplayer:submit:v1:engagement", components: [
+        { type: 18, component: { type: 4, custom_id: "starplayer:task-date", value: "2999-01-01" } },
+        { type: 18, component: { type: 4, custom_id: "starplayer:link", value: "https://example.com/task" } },
+      ] },
+    }, () => { invoked = true; });
+    expect((await response.json()).data.embeds[0].description).toContain("future");
+    expect(invoked).toBe(false);
+  });
+
+  it("requires a link or an attachment before deferring a submission", async () => {
+    let invoked = false;
+    const response = handleStarplayerSubmission({ ...base, type: 5,
+      data: { custom_id: "starplayer:submit:v1:engagement", components: [
+        { type: 18, component: { type: 4, custom_id: "starplayer:task-title", value: "Discussion post" } },
+      ] },
+    }, () => { invoked = true; });
+    expect((await response.json()).data.embeds[0].description).toContain("link or attach");
+    expect(invoked).toBe(false);
+  });
+
+  it("rejects a missing task title even when a link is present", async () => {
+    let invoked = false;
+    const response = handleStarplayerSubmission({ ...base, type: 5,
+      data: { custom_id: "starplayer:submit:v1:others", components: [
+        { type: 18, component: { type: 4, custom_id: "starplayer:link", value: "https://example.com/task" } },
+      ] },
+    }, () => { invoked = true; });
+    expect((await response.json()).data.embeds[0].description).toContain("task title");
+    expect(invoked).toBe(false);
+  });
+
+  it("accepts a file-only submission and defers sheet recording", async () => {
+    let invoked = false;
+    const response = handleStarplayerSubmission({ ...base, type: 5,
+      data: { custom_id: "starplayer:submit:v1:strategy-tips", components: [
+        { type: 18, component: { type: 4, custom_id: "starplayer:task-title", value: "Teamfight guide" } },
+        { type: 18, component: { type: 19, custom_id: "starplayer:file", values: ["777"] } },
+      ], resolved: { attachments: { "777": { id: "777", filename: "task.png", size: 100,
+        url: "https://cdn.discordapp.com/ephemeral-attachments/777/task.png" } } } },
+    }, () => { invoked = true; });
+    expect((await response.json()).type).toBe(5);
+    expect(invoked).toBe(true);
+  });
+});
