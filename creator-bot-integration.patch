+import { StarplayerSheetsStore } from "@/lib/starplayer/sheets";
+import { discordConfig } from "@/lib/config";
+
+export async function GET() {
+  let stage = "credentials";
+  try {
+    const store = new StarplayerSheetsStore();
+    stage = "sheet access";
+    await store.readSubmissions();
+    stage = "Discord bot token";
+    const { applicationId, botToken } = discordConfig();
+    if (!botToken) throw new Error("DISCORD_BOT_TOKEN is missing.");
+    const response = await fetch("https://discord.com/api/v10/users/@me", {
+      headers: { authorization: `Bot ${botToken}` }, cache: "no-store",
+    });
+    if (!response.ok) throw new Error(`Discord rejected the bot token (${response.status}).`);
+    const bot = await response.json() as { id?: string };
+    if (bot.id !== applicationId) throw new Error("DISCORD_BOT_TOKEN belongs to a different application.");
+    return Response.json({ ok: true, service: "starplayer-submissions" }, {
+      headers: { "Cache-Control": "no-store" },
+    });
+  } catch (error) {
+    console.error("Starplayer readiness failed.", error);
+    return Response.json({ ok: false, service: "starplayer-submissions", stage }, {
+      status: 503, headers: { "Cache-Control": "no-store" },
+    });
+  }
+}
