+      if (input.startsWith("{")) key = JSON.parse(input);
+      else if (input.startsWith('"') && input.endsWith('"')) {
+        try { key = JSON.parse(input); }
+        catch { key = input.slice(1, -1); }
+      } else if (input.startsWith("'") && input.endsWith("'")) key = input.slice(1, -1);
